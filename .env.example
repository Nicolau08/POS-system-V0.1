# =============================================================================
# POSly — Variáveis de ambiente
# Copie para .env.local (dev) ou configure no servidor de licenças / build.
# =============================================================================

# --- Supabase (sync cloud + consola de licenças) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service role — apenas no servidor API / consola (NUNCA no cliente)
# Dashboard Supabase → Settings → API → service_role (secret). JWT com "role":"service_role".
# NÃO use anon key nem sb_publishable_* — RLS em license_clients bloqueia inserts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Licenciamento (obrigatório para activação de vouchers) ---
# Mesmo segredo no POS, Electron, e consola /api/license-issuer
POS_LICENSE_HMAC_SECRET=
# URL da consola de licenças (ex.: https://licencas.seudominio.com)
# Dev local com projecto separado license-console/: http://localhost:3002
POS_LICENSE_ISSUER_BASE_URL=
# Token de admin da consola /license-admin
LICENSE_ISSUER_ADMIN_TOKEN=
# Apenas desenvolvimento — NUNCA em produção
# POS_LICENSE_ALLOW_UNSIGNED=false

# --- API / web locais ---
# Dev: web 3000, API 3001. Instalador empacotado usa 3730/3731 (fixado no Electron).
POS_API_PORT=3001
# POS_WEB_PORT=3000
POS_API_BIND=127.0.0.1
# Multi-posto LAN (Electron aplica automaticamente a partir de Configurações → Postos):
# POS_API_BIND=0.0.0.0
# POS_LAN_ACCESS=1
# POS_STATION_DISCOVERY=1
# POS_AUTH_HMAC_SECRET=
# (Se vazio, a API gera e grava auth-hmac.secret junto à BD — nunca usa secret fixo.)
# AUTH_BEARER_TTL_SECONDS=43200
# TRUST_PROXY=false
# Caminhos opcionais (Electron define automaticamente em %AppData%\POSly)
# POS_DB_PATH=
# POS_BACKUP_DIR=
# POS_USER_DATA_PATH=
# POS_CONFIG_PATH=
# POS_LICENSE_PATH=
# Encriptação SQLCipher (Electron gera a chave com safeStorage e injeta automaticamente).
# Em dev sem Electron, deixar vazio = BD plaintext. Nunca partilhar a chave.
# POS_DB_ENCRYPTION_KEY=
# POS_DB_ENCRYPTION=1
# BACKUP_INTERVAL_HOURS=6
# BACKUP_RETENTION_COUNT=14

# --- Sync ---
SYNC_INTERVAL_MS=10000
# ENABLE_FULL_RESET_SYNC=false

# --- Provisioning SaaS local (apenas consola / operador) ---
# Obrigatório para /saas/* — sem secret as rotas respondem 503.
POS_SAAS_ADMIN_SECRET=
# Header: x-saas-admin-secret

# --- Licenciamento serial legado (opcional) ---
# POS_LICENSE_SERVER_URL=
# Obrigatório para /setup/license/bind-serial (fail-closed se vazio)
# POS_LICENSE_ACTIVATION_SECRET=

# --- Multi-tenant dev ---
# DEFAULT_TENANT_ID=tenant-1
# DEFAULT_TENANT_NAME=Loja

# --- Desktop / Electron ---
# POS_APP_MODE=pos
# POS_DISABLE_AUTO_UPDATE=0
# AUTH_ALLOW_LEGACY_LOCAL=1

# --- Consola de licenças (dev separado) ---
# Projecto Next em license-console/ (porta 3002). Deploy Vercel: Root Directory = license-console
NEXT_PUBLIC_LICENSE_CONSOLE_URL=http://localhost:3002
