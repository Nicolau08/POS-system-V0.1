{
  "name": "ai-studio-applet",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "api:dev": "node api/server.js",
    "dev:full": "concurrently --names \"API,WEB\" --prefix-colors \"blue.bold,magenta.bold\" \"npm run api:dev\" \"npm run dev\"",
    "licensing:ensure-env": "node scripts/ensure-licensing-env.mjs",
    "dev:licensing": "node scripts/ensure-licensing-env.mjs && npm run dev:full",
    "license-console": "cross-env POS_APP_MODE=license-console POS_ELECTRON_USE_EXTERNAL_API=1 electron .",
    "dev:licensing:electron": "node scripts/ensure-licensing-env.mjs && concurrently --names \"API,WEB,POS,CONSOLE\" --prefix-colors \"blue.bold,magenta.bold,green.bold,yellow.bold\" \"npm run api:dev\" \"npm run dev\" \"npx wait-on http://127.0.0.1:3000 http://127.0.0.1:3001 && cross-env POS_ELECTRON_USE_EXTERNAL_API=1 npm run electron\" \"npx wait-on http://127.0.0.1:3000 http://127.0.0.1:3001 && npm run license-console\"",
    "dev:tenant:default": "node scripts/dev-tenant.mjs default",
    "dev:tenant": "node scripts/dev-tenant.mjs",
    "dev:tenant:qa01": "node scripts/dev-tenant.mjs qa01",
    "dev:tenant:qa02": "node scripts/dev-tenant.mjs qa02",
    "dev:tenant:qa03": "node scripts/dev-tenant.mjs qa03",
    "build": "next build",
    "electron:clean": "node scripts/clean-electron-dist.mjs",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:prepare-pos-build": "node scripts/prepare-pos-desktop-build.mjs exclude",
    "electron:restore-pos-build": "node scripts/prepare-pos-desktop-build.mjs restore",
    "electron-pack": "node scripts/electron-dist-pos.mjs --dir",
    "electron-dist": "node scripts/electron-dist-pos.mjs",
    "electron-dist:pos": "npm run electron-dist",
    "test:e2e": "playwright test",
    "sync:revive-dead-sales": "node api/scripts/revive-dead-sale-queue.mjs",
    "sync:reset-sale-queue": "node api/scripts/reset-sale-queue.mjs",
    "stock:audit": "node api/scripts/stock-flow-audit.mjs",
    "license:import-sqlite": "node scripts/migrate-sqlite-licenses-to-supabase.mjs",
    "icon:win": "node scripts/generate-windows-icon.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "autoprefixer": "^10.4.21",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.2.1",
    "node-machine-id": "^1.1.12",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.4",
    "electron-builder": "^26.0.12",
    "eslint": "^10.1.0",
    "eslint-config-next": "^0.2.4",
    "firebase-tools": "^15.11.0",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "main": "electron/main.js",
  "description": "POS System desktop application",
  "build": {
    "appId": "com.nicol.possystem",
    "productName": "POSly",
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "api/**/*",
      "assets/**/*",
      "lib/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sqlite3/**",
      "**/node_modules/@mapbox/node-pre-gyp/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone/server.js",
        "to": "web/server.js"
      },
      {
        "from": ".next/standalone/package.json",
        "to": "web/package.json"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "web/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/.next",
        "to": "web/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "web/.next/static"
      },
      {
        "from": "public",
        "to": "web/public"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "executableName": "POSly",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "POSly Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "POSly",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nicolau08",
        "repo": "POS-system-V0.1"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicolau08/POS-system-V0.1.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Nicolau08/POS-system-V0.1/issues"
  },
  "homepage": "https://github.com/Nicolau08/POS-system-V0.1#readme"
}
