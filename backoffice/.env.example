# Etapa 1G.4 Fase 2 — nunca commitar .env.local com valores reais.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só lido server-side (Route Handlers). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Etapa 1G.4 Fase 10 — SMTP real (lib/mailer.ts). Sem os 4 primeiros preenchidos, o
# mailer cai no stub de dev (nunca envia) e, em produção, falha fechado (nunca finge que
# enviou). Nunca commitar valores reais — só em .env.local.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=POSly <noreply@giga-it.co.mz>
BACKOFFICE_PUBLIC_URL=http://localhost:3003
# Só tem efeito fora de produção — devolve o token/link no corpo da resposta (dev/testes).
BACKOFFICE_DEV_MAIL_ECHO=false
